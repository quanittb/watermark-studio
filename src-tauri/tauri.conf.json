{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watermark Studio by QuanPH",
  "version": "0.1.0",
  "identifier": "com.watermarkstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watermark Studio by QuanPH",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MkUxQUEwRjZCRjNFMTcKUldRWFByLzJvQm91NTVSZFlYeERTbVBOSlBWSGFmZWc0T0FQUVZ1a3pqWU9vSFJmejFNWFFqeXEK",
      "endpoints": ["https://github.com/quanittb/watermark-studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
